# Copier en .env (non versionné) et adapter. Voir docs/docker.md.

# Profils activés par « docker compose up -d » : pile applicative complète.
# Ajouter monitoring pour Prometheus, Alertmanager et Grafana : COMPOSE_PROFILES=full,monitoring
COMPOSE_PROFILES=full

# Secrets locaux (à changer hors poste de développement).
POSTGRES_PASSWORD=changez-moi
GRAFANA_PASSWORD=changez-moi

# Simulateur : débit en événements par seconde.
SIMULATOR_RATE=80

# Sans tuiles produites par « docker compose --profile tiles run --rm tiles » : décommenter pour un fond neutre
# sans erreurs de chargement. Ces valeurs sont intégrées au frontend à la construction de l'image.
# VITE_BASEMAP_URL=
# VITE_MOTORWAYS_URL=
# VITE_GLYPHS_URL=
# VITE_SPRITE_URL=

# Ports publiés (le frontend sur toutes les interfaces ; les autres sur 127.0.0.1 uniquement).
# FRONTEND_PORT=8080
# BACKEND_PORT=8081
# KAFKA_EXTERNAL_PORT=29092
# POSTGRES_PORT=5432
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# GRAFANA_PORT=3000
# GRAFANA_BIND=127.0.0.1

# Profil tiles : date AAAAMMJJ d'un build listé sur https://maps.protomaps.com/builds (obligatoire pour ce profil).
# PROTOMAPS_BUILD=
# TILES_BBOX=-5.5,41.2,10.0,51.3
# TILES_MAXZOOM=12
# OSM_MODE=single
# Mode « regions » : téléchargements parallèles des extraits régionaux.
# REGION_JOBS=8

# Charge estimée des tronçons : après `docker compose --profile tiles run --rm tiles`, indiquer le graphe produit
# (chemin dans le conteneur). Vide = fonction inactive, aucun message « segments ».
# ASSIGNMENT_GRAPH_FILE=/app/graph/graph-AAAAMMJJ.json

# Authentification OIDC (Keycloak). COMPOSE_PROFILES=full,auth et SUPERVISION_PROFILE=auth rendent la connexion obligatoire.
# Utilisateurs de développement importés : « viewer » (lecture) et « admin » (lecture + administration).
# Ces secrets sont exigés par Compose pour tous les profils (interpolation de tout le fichier) : à changer partout ailleurs.
KEYCLOAK_ADMIN_PASSWORD=changez-moi
SUPERVISION_CLIENT_SECRET=changez-moi
KEYCLOAK_VIEWER_PASSWORD=changez-moi
KEYCLOAK_ADMIN_USER_PASSWORD=changez-moi
# SUPERVISION_PROFILE=auth
# PUBLIC_URL=http://localhost:8080
# KEYCLOAK_PUBLIC_URL=http://localhost:8180
