{
  "uid": "supervision-gares",
  "title": "Supervision des gares de péage",
  "tags": [
    "peage",
    "kafka",
    "supervision"
  ],
  "timezone": "Europe/Paris",
  "refresh": "15s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
